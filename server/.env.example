PORT=5000
# REQUIRED (min 32 chars). The server refuses to start without it. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
NODE_ENV=development

# Optional AI API keys. If not provided or if external API fails,
# the system automatically degrades gracefully to the internal
# BookLeaf Knowledge-Base-driven AI Engine!
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=auto
